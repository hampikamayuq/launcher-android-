<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+. Os dois canais são declarados separadamente de propósito: o que o
  app guarda hoje (favoritos) é pequeno e pessoal, então vale na transferência
  entre aparelhos, mas não precisa subir para a nuvem.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
