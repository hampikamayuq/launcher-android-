<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+. Os dois canais são declarados separadamente de propósito: o que o
  app guarda hoje (favoritos e aparência) é pequeno e pessoal, então vale na
  transferência entre aparelhos, mas não precisa subir para a nuvem.

  `fonts` é a fonte que o usuário importou: sem ela o tema restaurado cai na
  fonte do sistema, então acompanha as preferências nos dois canais.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
        <include domain="file" path="fonts" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
        <include domain="file" path="fonts" />
    </device-transfer>
</data-extraction-rules>
