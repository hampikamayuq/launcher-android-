<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Visibilidade de pacotes: em vez de QUERY_ALL_PACKAGES, declaramos apenas o
      filtro que um launcher precisa. Isso cobre LauncherApps.getActivityList sem
      pedir a permissão de maior alcance do Android.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!--
          Pacotes de ícones do formato aberto: as três ações que eles declaram há
          anos. Sem isso, queryIntentActivities não enxerga nenhum deles.
        -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
    </queries>

    <!--
      Permissão normal (concedida na instalação, sem diálogo): serve só para
      listar os apps do perfil privado do Android 15 quando ele está desbloqueado.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_HIDDEN_PROFILES"
        android:minSdkVersion="35" />

    <!-- Declarada; só é pedida quando o card de agenda é ligado. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!--
      BIND_APPWIDGET é permissão de sistema: um launcher de terceiro nunca a
      recebe na instalação. Declará-la é o que o AOSP faz — ela não é concedida
      aqui, mas é o que permite ao sistema lembrar da autorização que o usuário
      dá uma única vez no diálogo de ACTION_APPWIDGET_BIND. Sem o diálogo, nenhum
      widget liga; com ele, os próximos ligam sozinhos.

      O lint avisa que ela só é concedida a app de sistema — é verdade, e é o
      ponto: declarada e não concedida é exatamente o estado que o fluxo espera.
    -->
    <uses-permission
        android:name="android.permission.BIND_APPWIDGET"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".CascataApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Cascata">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:screenOrientation="nosensor"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Cascata.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Configurações. Não exportada: quem abre é a própria home. O filtro de
          APPLICATION_PREFERENCES existe para o sistema saber que este app tem
          uma tela de preferências, e é o caminho que as configurações do Android
          usam para chegar até ela.
        -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings"
            android:theme="@style/Theme.Cascata">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Seletor de widgets. Não exportada: quem abre é a home ou a tela de
          configurações, e o fluxo de bind/configuração depende do host que vive
          neste processo.
        -->
        <activity
            android:name=".widgets.WidgetPickerActivity"
            android:exported="false"
            android:label="@string/widget_picker_title"
            android:theme="@style/Theme.Cascata" />

        <!--
          Acesso a notificações. O serviço é exportado porque quem faz bind nele é
          o sistema, e a permissão BIND_NOTIFICATION_LISTENER_SERVICE garante que
          só ele consegue. Nada acontece até o usuário conceder o acesso na tela do
          Android: antes disso a classe nem chega a ser instanciada.
        -->
        <service
            android:name=".notifications.CascataNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Restauração de backup: o sistema realoca os ids de widget e avisa por
          este broadcast, com os antigos e os novos. Exportado porque quem envia é
          o Android — como no AOSP, não há permissão a exigir de quem manda.
        -->
        <receiver
            android:name=".widgets.AppWidgetsRestoredReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_HOST_RESTORED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
