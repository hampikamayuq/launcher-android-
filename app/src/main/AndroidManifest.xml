<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Visibilidade de pacotes: em vez de QUERY_ALL_PACKAGES, declaramos apenas o
      filtro que um launcher precisa. Isso cobre LauncherApps.getActivityList sem
      pedir a permissão de maior alcance do Android.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!--
          Pacotes de ícones do formato aberto: as três ações que eles declaram há
          anos. Sem isso, queryIntentActivities não enxerga nenhum deles.
        -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>

        <!--
          Índice de configurações do sistema na busca: sem enxergar o app de
          Configurações, Intent.resolveActivity devolve null para todas as telas
          e a seção inteira some. Uma ação só, a da tela principal — é o mínimo
          que torna o pacote visível para o resolve das demais.
        -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <!--
      Permissão normal (concedida na instalação, sem diálogo): serve só para
      listar os apps do perfil privado do Android 15 quando ele está desbloqueado.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_HIDDEN_PROFILES"
        android:minSdkVersion="35" />

    <!-- Declarada; só é pedida quando o card de agenda é ligado. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Declarada; pedida só ao ligar contatos na busca. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      Acesso especial, não permissão de diálogo: quem concede é o usuário na tela
      do sistema (Settings.ACTION_USAGE_ACCESS_SETTINGS), e só é pedida ao ligar o
      recurso de uso do aparelho. Declarada e não concedida é o estado normal — o
      lint avisa que só app de sistema a recebe na instalação, e é esse o ponto.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      BIND_APPWIDGET é permissão de sistema: um launcher de terceiro nunca a
      recebe na instalação. Declará-la é o que o AOSP faz — ela não é concedida
      aqui, mas é o que permite ao sistema lembrar da autorização que o usuário
      dá uma única vez no diálogo de ACTION_APPWIDGET_BIND. Sem o diálogo, nenhum
      widget liga; com ele, os próximos ligam sozinhos.

      O lint avisa que ela só é concedida a app de sistema — é verdade, e é o
      ponto: declarada e não concedida é exatamente o estado que o fluxo espera.
    -->
    <uses-permission
        android:name="android.permission.BIND_APPWIDGET"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".CascataApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Cascata">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:screenOrientation="nosensor"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Cascata.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Configurações. Não exportada: quem abre é a própria home. O filtro de
          APPLICATION_PREFERENCES existe para o sistema saber que este app tem
          uma tela de preferências, e é o caminho que as configurações do Android
          usam para chegar até ela.
        -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings"
            android:theme="@style/Theme.Cascata">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Seletor de widgets. Não exportada: quem abre é a home ou a tela de
          configurações, e o fluxo de bind/configuração depende do host que vive
          neste processo.
        -->
        <activity
            android:name=".widgets.WidgetPickerActivity"
            android:exported="false"
            android:label="@string/widget_picker_title"
            android:theme="@style/Theme.Cascata" />

        <!--
          Relatório de falha. Vive num processo próprio (`:crash`) porque o
          processo que quebrou já está morrendo quando ela sobe — no mesmo
          processo não haveria nada de pé para desenhar a tela. Não exportada
          (só o próprio app a abre), fora dos recentes (não é uma tela para
          voltar depois) e com o tema opaco: o da home é transparente sobre o
          papel de parede, e um relatório de erro precisa de fundo.
        -->
        <activity
            android:name=".crash.CrashActivity"
            android:process=":crash"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:label="@string/crash_title"
            android:theme="@style/Theme.Cascata" />

        <!--
          Acesso a notificações. O serviço é exportado porque quem faz bind nele é
          o sistema, e a permissão BIND_NOTIFICATION_LISTENER_SERVICE garante que
          só ele consegue. Nada acontece até o usuário conceder o acesso na tela do
          Android: antes disso a classe nem chega a ser instanciada.
        -->
        <service
            android:name=".notifications.CascataNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Restauração de backup: o sistema realoca os ids de widget e avisa por
          este broadcast, com os antigos e os novos. Exportado porque quem envia é
          o Android — como no AOSP, não há permissão a exigir de quem manda.
        -->
        <receiver
            android:name=".widgets.AppWidgetsRestoredReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_HOST_RESTORED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
